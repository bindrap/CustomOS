# Mako notification config - macOS-style
font=SF Pro Display 12
background-color=#1e1e2ecc
text-color=#cdd6f4
border-color=#89b4fa55
border-size=1
border-radius=12
default-timeout=5000
max-visible=3
layer=overlay
anchor=top-right
margin=12,12,0,0
padding=16,16
width=360
height=100
icon-location=left
max-icon-size=48
group-by=app-name

[urgency=high]
border-color=#f38ba8
background-color=#1e1e2edd
default-timeout=0
