{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "style": "/home/parteek/.config/waybar/styles/translucent.css",

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "wlr/taskbar"
    ],

    "modules-center": [
        "clock",
        "custom/weather"
    ],

    "modules-right": [
        "mpd",
        "pulseaudio",
        "cpu",
        "temperature",
        "network",
        "bluetooth",
        "battery",
        "tray",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "",
        "on-click": "wofi --show drun",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true,
        "all-outputs": true,
        "persistent-workspaces": {
            "*": 5
        }
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "active-only": false,
        "all-outputs": false,
        "on-click": "activate",
        "on-click-right": "close"
    },

    "clock": {
        "format": "{:%a %b %d  %I:%M %p}",
        "format-alt": "{:%A, %B %d, %Y  %I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#89b4fa'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'><b>{}</b></span>",
                "weeks": "<span color='#a6e3a1'><b>W{}</b></span>",
                "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip-format": "{percent}%"
    },

    "battery": {
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰂄",
        "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{capacity}% {timeTo}"
    },

    "network": {
        "interval": 5,
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh full"
    },

    "bluetooth": {
        "format": "󰂲",
        "format-connected": "󰂯",
        "format-disabled": "",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh full",
        "tooltip-format": "{status}"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "~/.config/hypr/scripts/volume-notify.sh up",
        "on-scroll-down": "~/.config/hypr/scripts/volume-notify.sh down",
        "tooltip-format": "{volume}%"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 6,
        "show-passive-items": true
    },

    "custom/power": {
        "format": "󰐥",
        "on-click": "~/.config/waybar/scripts/power-modal.sh",
        "on-click-right": "~/.config/waybar/scripts/power-dropdown.sh",
        "tooltip": false
    },

    "custom/weather": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/weather.sh",
        "interval": 1800,
        "return-type": "json",
        "on-click": "xdg-open https://wttr.in",
        "tooltip": true
    },

    "mpd": {
        "format": "󰒮  󰐊  󰒭  {title} — {artist}",
        "format-paused": "󰒮  󰏤  󰒭  {title} — {artist}",
        "format-stopped": "",
        "format-disconnected": "",
        "format-unknown": "",
        "state-icons": {
            "playing": "󰐊",
            "paused": "󰏤",
            "stopped": "󰓛"
        },
        "max-length": 48,
        "unknown-tag": "",
        "tooltip": true,
        "on-click": "mpc toggle",
        "on-click-right": "mpc next",
        "on-click-middle": "mpc prev",
        "on-scroll-up": "mpc prev",
        "on-scroll-down": "mpc next"
    },

    "cpu": {
        "interval": 2,
        "format": "",
        "tooltip": true,
        "tooltip-format": "CPU: {usage}%"
    },

    "temperature": {
        "interval": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format": "{icon}",
        "format-icons": ["", "", "", "", ""],
        "tooltip": true,
        "tooltip-format": "{temperatureC}°C"
    }
}
